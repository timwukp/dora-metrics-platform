# ─── Required ─────────────────────────────────────────────────
# Database connection string. Use a strong password in any non-local env.
# For EKS, prefer RDS + IAM auth and inject via External Secrets Operator.
DORA_DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/dora_metrics

# GitHub fine-grained PAT — read-only on target repos.
# Required scopes: contents:read, pull-requests:read, actions:read, metadata:read
# Generate at: https://github.com/settings/personal-access-tokens/new
DORA_GITHUB_TOKEN=

# Comma-separated list of repos to track (owner/name).
DORA_GITHUB_REPOS=YOUR_ORG/YOUR_REPO

# Webhook HMAC secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — webhook endpoint rejects all requests without this set.
DORA_GITHUB_WEBHOOK_SECRET=

# API key for protected mutating endpoints (POST /collect/*).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED — mutating endpoints return 401 without this set.
DORA_API_KEY=

# Allowed CORS origins — exact origin URLs, comma-separated.
# DO NOT use "*" with credentials. Set to your frontend origin(s) only.
DORA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Optional ─────────────────────────────────────────────────
# Claude Code Admin API (org-wide aggregated AI usage metrics).
# Get from Anthropic Console → Settings → Admin Keys.
DORA_CLAUDE_CODE_ADMIN_KEY=

# OpenTelemetry endpoint (if you want real-time per-developer Claude Code metrics).
DORA_OTEL_ENABLED=false
DORA_OTEL_ENDPOINT=http://localhost:4317

# How often to poll GitHub (minutes). Lower = fresher data, higher API usage.
DORA_POLL_INTERVAL_MINUTES=15

# Log level: DEBUG, INFO, WARNING, ERROR
DORA_LOG_LEVEL=INFO
