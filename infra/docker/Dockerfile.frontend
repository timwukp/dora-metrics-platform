# syntax=docker/dockerfile:1.7

# ─── Builder ──────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app
# Don't set NODE_ENV=production here — it skips devDependencies (vite, etc.)
# during install. We only want production at runtime, but build needs all deps.
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false

COPY frontend/package.json frontend/package-lock.json* ./
RUN if [ -f package-lock.json ]; then \
      npm ci --include=dev --no-audit; \
    else \
      npm install --include=dev --no-audit; \
    fi

COPY frontend/ .
RUN npm run build

# ─── Runtime ──────────────────────────────────────────────────
FROM nginx:1.31-alpine AS runtime

# Drop all default nginx config; install ours.
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/* \
    && apk add --no-cache curl tini \
    # nginx already runs worker procs as the 'nginx' user, but the master is root
    # by default. Switch master to nginx and adjust dirs accordingly.
    && sed -i 's|^user .*|user nginx;|' /etc/nginx/nginx.conf \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf \
    && sed -i 's|listen       80;|listen 8080;|' /etc/nginx/conf.d/default.conf 2>/dev/null || true \
    && touch /tmp/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /tmp/nginx.pid /etc/nginx/conf.d /usr/share/nginx/html

COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["nginx", "-g", "daemon off;"]
